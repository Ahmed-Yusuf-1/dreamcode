# Copy this file to ".env.local" and fill in the values.
#
# NEXT_PUBLIC_ values are safe to expose to the browser. Anything without that
# prefix is server-only and must NEVER be shipped to the client (keep it out of
# any NEXT_PUBLIC_ variable).

# --- Supabase (Supabase dashboard -> Project Settings -> API) ---------------
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# --- Public site URL --------------------------------------------------------
# Used for SEO metadata (metadataBase / Open Graph / canonical).
# Production: https://dreamcoder.dev . In local dev set http://localhost:3000 .
# Auth and Spotify redirects use the live browser origin, so they follow whatever
# domain the app is served from - this value only affects metadata.
NEXT_PUBLIC_SITE_URL=https://dreamcoder.dev

# --- Dream Guide (the AI hint mentor) ---------------------------------------
# All server-only - NEVER prefix with NEXT_PUBLIC_. Until AI_PROVIDER + AI_API_KEY
# + AI_MODEL are all set, the guide stays switched off and shows a "not on yet"
# message; the rest of the app is unaffected. Pick ONE provider and fill in its
# key + model.
#
#   AI_PROVIDER : gemini | openai | anthropic
#                 (openai also works for any OpenAI-compatible API via AI_BASE_URL)
#   AI_API_KEY  : the provider API key
#   AI_MODEL    : the model id (e.g. a Gemini, GPT, or Claude model name)
#   AI_BASE_URL : optional - override the provider base URL (self-hosted or
#                 OpenAI-compatible gateways)
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=
# AI_BASE_URL=

# Optional: set to "true" to gate the Dream Guide behind a Pro account
# (profiles.tier = 'pro'). Leave unset/false during development.
# GUIDE_REQUIRE_PRO=false
